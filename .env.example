# Optional: enables the server-side AI chat endpoint. Never expose this as VITE_*.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# The Express server defaults to port 3000.
PORT=3000

# Persistent storage for authenticated Fiscal source-document batches.
# Use a dedicated PostgreSQL database/role for this service; never commit the URL.
DATABASE_URL=
# Set to require when the PostgreSQL provider requires TLS.
PGSSLMODE=require

# Must match the secret configured in the Murade Fiscal service.
MURADE_INTEGRATION_TOKEN=
